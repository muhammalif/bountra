# ==========================================
# Bountra Frontend Web — Environment Configuration
# ==========================================

# Privy App ID (from dashboard.privy.io)
NEXT_PUBLIC_PRIVY_APP_ID=your_privy_app_id_here

# Deployed Escrow Contract on BSC Testnet
NEXT_PUBLIC_ESCROW_CONTRACT_ADDRESS=0xbe576879961Bd8cdf7CfA72F146C8a3E352c7260

# Optional Mock USDT address override. Source default: 0x189C7cA448e89DaF1C2A1C9a4DB4D9Ec475441c1.
# If set, it must match the deployed Mock USDT contract.
NEXT_PUBLIC_MOCK_USDT_ADDRESS=0x189C7cA448e89DaF1C2A1C9a4DB4D9Ec475441c1

# Chain ID (97 = BSC Testnet, 5611 = opBNB Testnet)
NEXT_PUBLIC_CHAIN_ID=97

# Backend Agent API URL
NEXT_PUBLIC_AGENT_API_URL=http://localhost:3001
