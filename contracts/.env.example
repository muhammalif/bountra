# ==========================================
# Bountra Contracts — Environment Template
# ==========================================

# Deployer Private Key (wallet with tBNB testnet balance)
PRIVATE_KEY=your_deployer_private_key_here

# Agent Signer Address (the public EVM address authorized to sign PR audit approvals)
AGENT_SIGNER=0xYourAgentSignerPublicAddressHere

# Verified Working RPC URLs (Chain ID: 97 for BSC Testnet, 5611 for opBNB Testnet)
BSC_TESTNET_RPC_URL=https://bsc-testnet-rpc.publicnode.com
BSC_TESTNET_RPC_FALLBACK=https://data-seed-prebsc-1-s1.bnbchain.org:8545
OPBNB_TESTNET_RPC_URL=https://opbnb-testnet-rpc.bnbchain.org

# Block Explorer API Keys for Verification
BSCSCAN_API_KEY=your_bscscan_api_key_here
OPBNBSCAN_API_KEY=your_opbnbscan_api_key_here
