# ==========================================
# Bountra Agent Backend — Environment Template
# ==========================================

PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# Comma-separated browser origins allowed to call the agent.
# The agent holds AGENT_PRIVATE_KEY and will sign a release for any bounty that
# passes an audit, so an unset value must never widen this to every origin.
# localhost is always included for development.
# Production example:
#   ALLOWED_ORIGINS=https://bountra.xyz,https://www.bountra.xyz
ALLOWED_ORIGINS=

# Agent Signer Private Key (signs cryptographic claim approvals)
# Must match the AGENT_SIGNER passed to the escrow contract constructor —
# a signature from an address the contract does not trust will be rejected.
# The value below is a public Anvil test key: use it for local chains only.
AGENT_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Deployed Escrow Contract Address
ESCROW_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000001

# Chain ID (97: BSC Testnet, 5611: opBNB Testnet)
CHAIN_ID=97

# Public BSC Testnet RPC. The agent reads claim transactions back from chain
# before recording them as settled, so it needs a node of its own — it cannot
# reuse the Next.js proxy.
BSC_TESTNET_RPC_URL=https://bsc-testnet-rpc.publicnode.com

# Google AI Studio API Key (for Gemini 2.0 Flash Auditor)
GEMINI_API_KEY=your_gemini_api_key_here

# GitHub Token for Octokit (fetching PR diff, check-runs, comments)
GITHUB_TOKEN=your_github_token_here

# SQLite Database Path
DATABASE_PATH=./data/bountra.db
